{
  "name": "tefast",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "bun --cwd frontend run dev",
    "dev:backend": "bun --cwd backend run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "build:frontend": "bun --cwd frontend run build",
    "build:backend": "bun --cwd backend run build",
    "check:frontend": "bun --cwd frontend run lint && bun --cwd frontend run typecheck",
    "check:backend": "bun --cwd backend run typecheck",
    "check": "turbo run lint typecheck",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "2.9.3"
  }
}
