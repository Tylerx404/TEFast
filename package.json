{
  "name": "tefast",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "build:frontend": "bun run --cwd frontend build",
    "build:backend": "bun run --cwd backend build",
    "check:frontend": "bun run --cwd frontend lint && bun run --cwd frontend typecheck",
    "check:backend": "bun run --cwd backend typecheck",
    "check": "turbo run lint typecheck",
    "db:bootstrap": "bun run --cwd backend db:bootstrap",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "2.9.3"
  }
}
